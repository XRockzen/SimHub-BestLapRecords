<UserControl x:Class="User.TeamPace.SessionListColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:User.TeamPace">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/User.TeamPace;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Key figures (circuit progression only) -->
        <Border x:Name="SummaryCard" Grid.Row="0" Background="#0DFFFFFF" CornerRadius="8" Padding="14,10,14,2"
                Margin="0,0,0,10" Visibility="Collapsed">
            <ItemsControl x:Name="SummaryItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="{Binding Label}" FontSize="10.5" Foreground="#8CFFFFFF" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Color}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Detail, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="TxtSummary" Grid.Row="1" FontSize="12" Foreground="#99FFFFFF" Margin="2,0,0,5"/>

        <DataGrid x:Name="SessionGrid" Grid.Row="2" Style="{StaticResource GridBase}"
                  IsReadOnly="True" CanUserSortColumns="True"
                  RowStyle="{StaticResource SessionRowStyle}"
                  SelectionChanged="SessionGrid_SelectionChanged"
                  MouseDoubleClick="SessionGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="⇄" Width="34" SortMemberPath="IsCommon"
                                        CellTemplate="{StaticResource CommonDotsTemplate}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="98" SortMemberPath="SessionDateTicks"/>
                <DataGridTemplateColumn Header="Type" Width="40" SortMemberPath="TypeLabel"
                                        CellTemplate="{StaticResource TypeBadgeTemplate}"/>
                <DataGridTextColumn x:Name="ColCircuit" Header="Circuit" Binding="{Binding Circuit}" Width="*" MinWidth="100"/>
                <DataGridTextColumn x:Name="ColCar" Header="Voiture" Binding="{Binding CarType}" Width="110"/>
                <DataGridTemplateColumn x:Name="ColClass" Header="Cl." Width="72" SortMemberPath="CarClassLabel"
                                        CellTemplate="{StaticResource ClassBadgeTemplate}"/>
                <DataGridTemplateColumn Header="Best" Width="76" SortMemberPath="BestTicks">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BestLap}" Foreground="{Binding BestLapFg}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColDelta" Header="Δ précédente" Width="86" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Delta}" Foreground="{Binding DeltaFg}" FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tours" Binding="{Binding TotalLaps}" Width="44"/>
                <DataGridTextColumn Header="Pos." Binding="{Binding Position}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
