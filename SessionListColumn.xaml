<UserControl x:Class="User.TeamPace.SessionListColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/User.TeamPace;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtSummary" Grid.Row="0" FontSize="10" Opacity="0.55" Margin="0,0,0,4"/>

        <DataGrid x:Name="SessionGrid" Grid.Row="1" Style="{StaticResource GridBase}"
                  IsReadOnly="True" CanUserSortColumns="True"
                  RowStyle="{StaticResource SessionRowStyle}"
                  SelectionChanged="SessionGrid_SelectionChanged"
                  MouseDoubleClick="SessionGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="⇄" Width="34" SortMemberPath="IsCommon"
                                        CellTemplate="{StaticResource CommonDotsTemplate}"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="98" SortMemberPath="SessionDateTicks"/>
                <DataGridTemplateColumn Header="Type" Width="40" SortMemberPath="TypeLabel"
                                        CellTemplate="{StaticResource TypeBadgeTemplate}"/>
                <DataGridTextColumn x:Name="ColCircuit" Header="Circuit" Binding="{Binding Circuit}" Width="*" MinWidth="100"/>
                <DataGridTextColumn x:Name="ColCar" Header="Voiture" Binding="{Binding CarType}" Width="110"/>
                <DataGridTemplateColumn x:Name="ColClass" Header="Cl." Width="72" SortMemberPath="CarClassLabel"
                                        CellTemplate="{StaticResource ClassBadgeTemplate}"/>
                <DataGridTemplateColumn Header="Best" Width="76" SortMemberPath="BestTicks">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BestLap}" Foreground="{Binding BestLapFg}" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColDelta" Header="Δ précédente" Width="86" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Delta}" Foreground="{Binding DeltaFg}" FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tours" Binding="{Binding TotalLaps}" Width="44"/>
                <DataGridTextColumn Header="Pos." Binding="{Binding Position}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
