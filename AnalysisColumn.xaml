<UserControl x:Class="User.TeamPace.AnalysisColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:User.TeamPace">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/User.TeamPace;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Key figure of the session card: small caps label above a large value -->
            <Style x:Key="KpiBox" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="KpiLbl" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="9.5"/>
                <Setter Property="Foreground" Value="#8CFFFFFF"/>
                <Setter Property="Margin"     Value="0,0,0,2"/>
            </Style>
            <Style x:Key="KpiVal" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#F2FFFFFF"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- Analysis blocks share one height so the lap tables line up across drivers -->
            <Style x:Key="AnaBlock" TargetType="Border">
                <Setter Property="Background"   Value="#10FFFFFF"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding"      Value="12,9"/>
                <Setter Property="Margin"       Value="0,0,8,8"/>
                <Setter Property="Width"        Value="196"/>
                <Setter Property="Height"       Value="112"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="BlockTitle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
                <Setter Property="Margin"     Value="0,0,0,4"/>
            </Style>
            <Style x:Key="BlockBig" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>
            <Style x:Key="BlockLine" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="Foreground" Value="#C8FFFFFF"/>
                <Setter Property="Margin"     Value="0,2,0,0"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#E6FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="140"/>
        </Grid.RowDefinitions>

        <!-- ═══ 1. Session card ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0DFFFFFF" CornerRadius="8" Padding="14,10,14,4" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="TxtDate" DockPanel.Dock="Right" FontSize="11" Foreground="#99FFFFFF"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border x:Name="BadgeClass" CornerRadius="3" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtClass" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="TxtCar" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <WrapPanel Margin="0,5,0,10">
                    <TextBlock x:Name="TxtTeam" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <WrapPanel x:Name="SimBadges" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtLive" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </WrapPanel>
                <UniformGrid x:Name="KpiGridPanel" Rows="1" SizeChanged="KpiGridPanel_SizeChanged">
                    <StackPanel x:Name="KpiFinishBox" Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="ARRIVÉE"/>
                        <TextBlock x:Name="KpiFinish" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel x:Name="KpiGridBox" Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="DÉPART"/>
                        <TextBlock x:Name="KpiGrid" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="MEILLEUR TOUR"/>
                        <TextBlock x:Name="KpiBest" Style="{StaticResource KpiVal}" Foreground="#FF66BB6A"/>
                    </StackPanel>
                    <StackPanel x:Name="KpiTheoBox" Style="{StaticResource KpiBox}" Background="Transparent" Cursor="Help"
                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="THÉORIQUE ⓘ"/>
                        <TextBlock x:Name="KpiTheo" Style="{StaticResource KpiVal}" Foreground="#FF90CAF9"
                                   TextDecorations="Underline"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="VITESSE MAX"/>
                        <TextBlock x:Name="KpiTop" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="TOURS"/>
                        <TextBlock x:Name="KpiLaps" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="ARRÊTS"/>
                        <TextBlock x:Name="KpiPits" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource KpiBox}">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="INCIDENTS"/>
                        <TextBlock x:Name="KpiIncidents" Style="{StaticResource KpiVal}"/>
                    </StackPanel>
                    <StackPanel x:Name="KpiInvalidBox" Style="{StaticResource KpiBox}" Background="Transparent" Cursor="Help"
                                ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="30000">
                        <TextBlock Style="{StaticResource KpiLbl}" Text="INVALIDES ⓘ"/>
                        <TextBlock x:Name="KpiInvalid" Style="{StaticResource KpiVal}" Foreground="#FFEF9A9A"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ═══ 2. Analysis of the checked laps ═══════════════════════════ -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock x:Name="TxtSelSummary" DockPanel.Dock="Right" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Analyse des tours sélectionnés"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel>
                <Border Style="{StaticResource AnaBlock}"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="RYTHME (moyenne)"/>
                    <TextBlock x:Name="TxtStAvg" Style="{StaticResource BlockBig}"/>
                    <TextBlock x:Name="TxtStVsBest" Style="{StaticResource BlockLine}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStBestWorst" Style="{StaticResource BlockLine}"/>
                </StackPanel></Border>

                <Border Style="{StaticResource AnaBlock}"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="RÉGULARITÉ"
                               ToolTip="Écart-type des tours sélectionnés : plus il est bas, plus les tours se ressemblent"/>
                    <TextBlock x:Name="TxtStSigma" Style="{StaticResource BlockBig}"/>
                    <TextBlock x:Name="TxtStSpread" Style="{StaticResource BlockLine}"/>
                    <TextBlock x:Name="TxtStDuree" Style="{StaticResource BlockLine}"/>
                </StackPanel></Border>

                <Border x:Name="StatsFuelPanel" Style="{StaticResource AnaBlock}"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="CARBURANT"/>
                    <TextBlock x:Name="TxtStFuelAvg" Style="{StaticResource BlockBig}"/>
                    <TextBlock x:Name="TxtStFuelTot" Style="{StaticResource BlockLine}"/>
                    <TextBlock x:Name="TxtStFuelLaps" Style="{StaticResource BlockLine}" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel></Border>

                <Border x:Name="StatsVePanel" Style="{StaticResource AnaBlock}"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="ÉNERGIE VIRTUELLE"/>
                    <TextBlock x:Name="TxtStVeAvg" Style="{StaticResource BlockBig}"/>
                    <TextBlock x:Name="TxtStVeTot" Style="{StaticResource BlockLine}" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel></Border>

                <Border x:Name="StatsTirePanel" Style="{StaticResource AnaBlock}"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="USURE PNEUS PAR TOUR"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtStTireFL" Grid.Row="0" Grid.Column="0" Style="{StaticResource BlockLine}"/>
                        <TextBlock x:Name="TxtStTireFR" Grid.Row="0" Grid.Column="1" Style="{StaticResource BlockLine}"/>
                        <TextBlock x:Name="TxtStTireRL" Grid.Row="1" Grid.Column="0" Style="{StaticResource BlockLine}"/>
                        <TextBlock x:Name="TxtStTireRR" Grid.Row="1" Grid.Column="1" Style="{StaticResource BlockLine}"/>
                    </Grid>
                </StackPanel></Border>

                <!-- Two blocks wide; its height is set from the longest stop list of all drivers -->
                <Border x:Name="StatsPitPanel" Style="{StaticResource AnaBlock}" Width="400"><StackPanel>
                    <TextBlock Style="{StaticResource BlockTitle}" Text="ARRÊTS AUX STANDS"/>
                    <ItemsControl x:Name="StatsPitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,3">
                                    <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource BlockLine}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel></Border>
            </WrapPanel>
            <TextBlock x:Name="TxtNoLiveHint" FontSize="11" Foreground="#80FFFFFF" FontStyle="Italic" TextWrapping="Wrap"
                       Text="Carburant et pneus : ces données sont capturées en direct, roulez avec SimHub ouvert pour les obtenir."/>
        </StackPanel>

        <!-- ═══ 3. Lap table, with its selection toolbar right above it ════ -->
        <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="6,6,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cocher :" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource SmallBtn}" Click="BtnValid_Click"
                            ToolTip="Tours représentatifs : valides, hors tour 1, hors passage aux stands et tour de sortie">Rythme</Button>
                    <Button Style="{StaticResource SmallBtn}" Click="BtnAll_Click">Tout</Button>
                    <Button Style="{StaticResource SmallBtn}" Click="BtnNone_Click" Margin="0">Aucun</Button>
                </StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Tour par tour"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="LapGrid" Grid.Row="4" Style="{StaticResource GridBase}"
                  IsReadOnly="False" CanUserSortColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background"      Value="{Binding RowBg}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor"          Value="Arrow"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                            <Setter Property="Opacity"   Value="0.5"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Width="26"
                    Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="#" Binding="{Binding LapNum}" Width="30" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Info" Width="118">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding InfoTooltip}">
                                <Border CornerRadius="2" Padding="3,0" Margin="0,1,2,1" Background="#BB1565B0"
                                        Visibility="{Binding FlagPit, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}">
                                    <TextBlock Text="{Binding FlagPit}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border CornerRadius="2" Padding="3,0" Margin="0,1,2,1" Background="#BB2E7D32"
                                        Visibility="{Binding FlagTire, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}">
                                    <TextBlock Text="{Binding FlagTire}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border CornerRadius="2" Padding="3,0" Margin="0,1,2,1" Background="#BBC62828"
                                        Visibility="{Binding FlagInvalid, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}">
                                    <TextBlock Text="{Binding FlagInvalid}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border CornerRadius="2" Padding="3,0" Margin="0,1,2,1" Background="{Binding FlagWarningBg}"
                                        Visibility="{Binding FlagWarning, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}">
                                    <TextBlock Text="{Binding FlagWarning}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <Border CornerRadius="2" Padding="3,0" Margin="0,1,2,1" Background="#CC5D4037"
                                        Visibility="{Binding FlagContact, Converter={x:Static local:VisibleWhenNotEmptyConverter.Instance}}">
                                    <TextBlock Text="{Binding FlagContact}" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Temps" Width="78">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding LapTime}" Foreground="{Binding LapTimeFg}" FontWeight="SemiBold" FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="ColTeamDelta" Header="Δ pilotes" Width="70" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TeamDelta}" Foreground="{Binding TeamDeltaFg}" FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="S1" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding S1}" Foreground="{Binding S1Fg}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="S2" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding S2}" Foreground="{Binding S2Fg}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="S3" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding S3}" Foreground="{Binding S3Fg}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColFuel" Header="Conso" Binding="{Binding FuelUsed}" Width="56" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColFuelLeft" Header="Carbu" Binding="{Binding FuelRemaining}" Width="54" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColVe" Header="VE" Binding="{Binding VeUsed}" Width="52" IsReadOnly="True" Visibility="Collapsed"/>
                <DataGridTextColumn x:Name="ColWear" Header="Usure" Binding="{Binding TireWearAvg}" Width="60" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
