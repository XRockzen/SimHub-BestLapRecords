<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BaseRowStyle" TargetType="DataGridRow">
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#28AAD4FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#4466AAFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Session rows: shared sessions keep a warm tint unless hovered/selected -->
    <Style x:Key="SessionRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource BaseRowStyle}">
        <Setter Property="Background" Value="{Binding RowBg}"/>
    </Style>

    <Style x:Key="CellStyle" TargetType="DataGridCell">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground"  Value="White"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dark headers: a light overlay on SimHub's background, readable secondary text -->
    <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="#1FFFFFFF"/>
        <Setter Property="Foreground"      Value="#C8FFFFFF"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="6,5,6,5"/>
        <Setter Property="BorderBrush"     Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GridBase" TargetType="DataGrid">
        <Setter Property="Background"           Value="Transparent"/>
        <Setter Property="RowBackground"        Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#0AFFFFFF"/>
        <Setter Property="Foreground"           Value="#E6FFFFFF"/>
        <Setter Property="FontSize"             Value="12"/>
        <Setter Property="RowHeight"            Value="22"/>
        <Setter Property="ColumnHeaderStyle"    Value="{StaticResource ColumnHeaderStyle}"/>
        <Setter Property="AutoGenerateColumns"  Value="False"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#14FFFFFF"/>
        <Setter Property="HeadersVisibility"    Value="Column"/>
        <Setter Property="BorderThickness"      Value="0"/>
        <Setter Property="RowHeaderWidth"       Value="0"/>
        <Setter Property="SelectionMode"        Value="Single"/>
        <Setter Property="CanUserAddRows"       Value="False"/>
        <Setter Property="CanUserDeleteRows"    Value="False"/>
        <Setter Property="CellStyle"            Value="{StaticResource CellStyle}"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    </Style>

    <Style x:Key="SectionLbl" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="9"/>
        <Setter Property="Opacity"    Value="0.45"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>
    <Style x:Key="StatLbl" TargetType="TextBlock">
        <Setter Property="Opacity"  Value="0.45"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Margin"   Value="0,0,0,1"/>
    </Style>
    <Style x:Key="StatVal" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="StatSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Opacity"  Value="0.65"/>
        <Setter Property="Margin"   Value="0,1,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="StatBlock" TargetType="Border">
        <Setter Property="Background"   Value="#0DFFFFFF"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding"      Value="10,6"/>
        <Setter Property="Margin"       Value="0,0,6,6"/>
        <Setter Property="Width"        Value="178"/>
    </Style>
    <!-- Own template: the Windows default hover (light blue) clashes with the dark theme -->
    <Style x:Key="NavBtn" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="#44FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="#DDFFFFFF"/>
        <Setter Property="Padding"         Value="10,4"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource NavBtn}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding"  Value="8,3"/>
        <Setter Property="Margin"   Value="0,0,4,0"/>
    </Style>

    <!-- Main tabs: the active one gets a coloured underline (set from code) -->
    <Style x:Key="TabBtn" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,3"/>
        <Setter Property="Foreground"      Value="#A6FFFFFF"/>
        <Setter Property="Padding"         Value="14,6,14,5"/>
        <Setter Property="Margin"          Value="0,0,2,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clickable breadcrumb segment -->
    <Style x:Key="CrumbLink" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="#FF64B5F6"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Category badge used in several grids -->
    <DataTemplate x:Key="ClassBadgeTemplate">
        <Border CornerRadius="3" Padding="4,1" Margin="2,1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{Binding CarClassBg}"
                BorderBrush="{Binding CarClassBorder}"
                BorderThickness="{Binding CarClassThick}">
            <TextBlock Text="{Binding CarClassLabel}" FontSize="9" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="TypeBadgeTemplate">
        <Border CornerRadius="3" Padding="4,1" Margin="2,1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{Binding TypeBg}">
            <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center"/>
        </Border>
    </DataTemplate>

    <!-- Dots in the other drivers' colours for sessions they share -->
    <DataTemplate x:Key="CommonDotsTemplate">
        <ItemsControl ItemsSource="{Binding CommonColors}" VerticalAlignment="Center"
                      ToolTip="Session commune avec ces pilotes">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Width="9" Height="9" Margin="1,0" Fill="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

</ResourceDictionary>
